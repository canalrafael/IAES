#!/bin/sh
# /etc/init.d/S99apparate
#
# Signals VM0 that the Linux boot has finished, so the monitor can print a
# confirmation on its serial console (VM2's own console is on a different UART).
#
# IPC_Channel layout (shared with VM0):
#   offset 0: signal_ready
#   offset 4: resume
#   offset 8: current_label
#   offset 12: boot_done

IPC_SIGNAL=/root/ipc_signal
SAY=/root/ipc_say
BOOT_DONE_OFFSET=12

# Relay one text line to VM0 and pause so its 200ms poll catches each message.
say() { [ -x "$SAY" ] && "$SAY" "$1" 2>/dev/null; sleep 1; }

case "$1" in
  start)
        if [ ! -c /dev/mem ]; then
            echo "[VM2] ERROR: /dev/mem not found, cannot signal VM0" > /dev/console
            exit 1
        fi
        if [ ! -x $IPC_SIGNAL ]; then
            echo "[VM2] ERROR: $IPC_SIGNAL not found" > /dev/console
            exit 1
        fi
        $IPC_SIGNAL write $BOOT_DONE_OFFSET 1
        echo "[VM2] boot finished, signaled VM0 (boot_done=1)" > /dev/console

        # The user only has the VM0 serial cable, so relay a startup diagnostic
        # to VM0. These checks catch the common failures (no python3, numpy not
        # built, code not staged) that would otherwise be invisible.
        say "boot ok; checking env"
        if ! command -v python3 >/dev/null 2>&1; then
            say "ERROR: no python3 in rootfs"; exit 0
        fi
        if ! python3 -c "import numpy" >/dev/null 2>&1; then
            say "ERROR: numpy import failed"; exit 0
        fi
        if [ ! -f /root/apparate-ae/apparate/controller.py ]; then
            say "ERROR: apparate code not staged in rootfs"; exit 0
        fi
        say "env ok; starting apparate"
        APPARATE_IPC_RELAY=1 APPARATE_LIVE_LATENCY=1 /root/run_apparate.sh > /tmp/apparate.log 2>&1 &

        # Watchdog: after a grace period (pickle loading is slow on the Pi),
        # relay whether it is running and whether the relay is active, or the
        # error tail if it died early.
        (
            sleep 30
            if grep -laq controller.py /proc/*/cmdline 2>/dev/null; then
                if grep -q "IPC relay to VM0 enabled" /tmp/apparate.log 2>/dev/null; then
                    say "apparate running; relay active"
                elif grep -q "IPC relay disabled" /tmp/apparate.log 2>/dev/null; then
                    R=$(grep "IPC relay disabled" /tmp/apparate.log | head -1)
                    say "RELAY OFF: ${R##*disabled: }"
                else
                    say "apparate running (still loading?)"
                fi
            else
                say "apparate EXITED early; tail:"
                T=$(tail -c 160 /tmp/apparate.log 2>/dev/null | tr '\n' ' ')
                say "$T"
            fi
        ) &
        ;;
  stop)
        $IPC_SIGNAL write $BOOT_DONE_OFFSET 0 2>/dev/null
        ;;
  restart|reload)
        $0 stop
        $0 start
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
exit 0
